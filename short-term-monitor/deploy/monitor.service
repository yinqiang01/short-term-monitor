[Unit]
Description=Short-Term Stock Monitor - 短线选股监控系统
After=network.target
Wants=network.target

[Service]
Type=simple
User=monitor
Group=monitor
WorkingDirectory=/opt/short-term-monitor
ExecStart=/usr/bin/python3 -m src.main
Restart=always
RestartSec=10
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=short-term-monitor

[Install]
WantedBy=multi-user.target
